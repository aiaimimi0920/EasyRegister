{
  "definition": {
    "version": "1",
    "id": "codex-openai-account-prestage-v1",
    "name": "Codex OpenAI Account Prestage Flow",
    "platform": "codex",
    "kind": "semantic-flow",
    "description": "Creates a real OpenAI account seed for the continue flow, then releases the mailbox and proxy without entering the long-running Codex OAuth stage.",
    "resourcePolicies": [],
    "metadata": {
      "mailbox": {
        "businessKey": "openai"
      },
      "taskRetry": {
        "maxAttempts": 6,
        "backoffSeconds": 3,
        "retryProfile": "task-openai-default",
        "retryOnSteps": [
          "acquire-mailbox",
          "acquire-proxy-chain",
          "create-openai-account"
        ]
      }
    },
    "steps": [
      {
        "id": "acquire-proxy-chain",
        "type": "acquire_proxy_chain",
        "input": {
          "flow_name": "codex_openai_account_prestage_task",
          "metadata": {
            "taskAttempt": "{{task.taskAttempt}}"
          },
          "probe_url": "https://chatgpt.com/auth/login",
          "probe_urls": [
            "https://chatgpt.com/auth/login",
            "https://platform.openai.com/login",
            "https://auth.openai.com/log-in-or-create-account"
          ],
          "probe_expected_statuses": [
            200
          ],
          "avoid_proxy_urls": "{{task.avoidProxyUrls}}",
          "required": true,
          "max_acquire_attempts": 4
        },
        "saveAs": "proxy_chain",
        "metadata": {
          "owner": "easyproxy",
          "stage": "proxy-acquire"
        }
      },
      {
        "id": "acquire-mailbox",
        "type": "acquire_mailbox",
        "input": {
          "preallocated_email": "{{task.preallocated_email}}",
          "preallocated_session_id": "{{task.preallocated_session_id}}",
          "preallocated_mailbox_ref": "{{task.preallocated_mailbox_ref}}",
          "recreate_preallocated_email": "{{task.mailbox_recreate_preallocated}}",
          "business_key": "{{task.mailbox_business_key}}",
          "avoid_emails": "{{task.avoidMailboxEmails}}",
          "avoid_domains": "{{task.avoidMailboxDomains}}",
          "avoid_providers": "{{task.avoidMailboxProviders}}",
          "avoid_reason": "{{task.avoidMailboxReason}}"
        },
        "saveAs": "mailbox",
        "metadata": {
          "owner": "easyemail",
          "stage": "mailbox-acquire"
        }
      },
      {
        "id": "create-openai-account",
        "type": "create_openai_account",
        "input": {
          "output_dir": "{{task.output_dir}}",
          "preallocated_email": "{{mailbox.email}}",
          "preallocated_session_id": "{{mailbox.session_id}}",
          "preallocated_mailbox_ref": "{{mailbox.mailbox_ref}}",
          "recovery_data_credential": "{{mailbox.recovery_data_credential}}",
          "proxy_url": "{{proxy_chain.proxy_url}}"
        },
        "saveAs": "create_openai_account",
        "metadata": {
          "owner": "easyprotocol",
          "stage": "account-create",
          "retry": {
            "maxAttempts": 2,
            "backoffSeconds": 2,
            "retryProfile": "step-create-account-recover",
            "refreshSavedStates": [
              "mailbox",
              "proxy_chain"
            ]
          }
        }
      },
      {
        "id": "release-proxy-chain",
        "type": "release_proxy_chain",
        "input": {
          "proxy_chain": "{{proxy_chain}}",
          "error_code": "{{task.errorCode}}"
        },
        "saveAs": "release_proxy_chain",
        "metadata": {
          "owner": "easyproxy",
          "stage": "cleanup",
          "alwaysRun": true
        }
      },
      {
        "id": "release-mailbox",
        "type": "release_mailbox",
        "input": {
          "source_path": "{{create_openai_account.storage_path}}",
          "email_address": "{{mailbox.email}}",
          "provider": "{{mailbox.provider}}",
          "mailbox_ref": "{{mailbox.mailbox_ref}}",
          "mailbox_session_id": "{{mailbox.session_id}}",
          "recovery_data_credential": "{{mailbox.recovery_data_credential}}"
        },
        "saveAs": "release_mailbox",
        "metadata": {
          "owner": "easyemail",
          "stage": "cleanup",
          "alwaysRun": true
        }
      }
    ]
  }
}
