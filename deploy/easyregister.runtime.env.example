# EasyRegister runtime env example for GitHub Actions smoke/publish flows.
# A full runtime env can be supplied via the GitHub secret EASYREGISTER_RUNTIME_ENV_B64.
# Individual keys can also be overridden by secrets prefixed with EASYREGISTER_ENV_.

EASY_PROTOCOL_BASE_URL=http://easy-protocol:9788
EASY_PROTOCOL_CONTROL_TOKEN=
EASY_PROTOCOL_CONTROL_ACTOR=easyregister-gha
EASY_PROTOCOL_TIMEOUT_SECONDS=900
EASY_PROTOCOL_ACCOUNT_AUDIT_TIMEOUT_SECONDS=300
REGISTER_PROTOCOL_BRIDGE_DIR=
REGISTER_PROTOCOL_BRIDGE_TARGET_DIR=
REGISTER_PROTOCOL_OUTPUT_MIRROR_DIR=
REGISTER_PROTOCOL_OUTPUT_TARGET_DIR=/shared/register-output

MAILBOX_SERVICE_BASE_URL=http://easy-email:8080
MAILBOX_SERVICE_API_KEY=
SMS_SERVICE_BASE_URL=http://easy-sms:8080
SMS_SERVICE_API_KEY=
SMS_SERVICE_SELECTION_PLAN_TIMEOUT_SECONDS=8
SMS_SERVICE_SELECTION_PLAN_ATTEMPTS=1
REGISTER_PHONE_VERIFICATION_TERMINAL_RETRY_ATTEMPTS=1
REGISTER_PHONE_VERIFICATION_SMS_CODE_WAIT_RETRY_ATTEMPTS=1

EASY_PROXY_BASE_URL=http://easy-proxy:29888
EASY_PROXY_RUNTIME_HOST=easy-proxy
EASY_PROXY_MANAGEMENT_USERNAME=easyproxy
EASY_PROXY_MANAGEMENT_PASSWORD=
EASY_PROXY_API_KEY=
EASY_PROXY_API_TIMEOUT_SECONDS=10
EASY_PROXY_INITIAL_PROBE_MAX_ATTEMPTS=4
EASY_PROXY_INITIAL_PROBE_BACKOFF_SECONDS=1

REGISTER_ENABLE_EASY_PROXY=true
REGISTER_REQUIRE_EASY_PROXY=true
REGISTER_PROXY_MODE=lease
REGISTER_PROXY_TTL_MINUTES=30
REGISTER_PROXY_UNIQUE_ATTEMPTS=3
REGISTER_PROXY_RECENT_WINDOW_SECONDS=180
REGISTER_PROXY_FAILURE_WINDOW_SECONDS=300

REGISTER_OUTPUT_ROOT=/shared/register-output/others/runs
REGISTER_INSTANCE_ID=easy-register
REGISTER_INSTANCE_ROLE=mixed
REGISTER_FLOW_PATH=
REGISTER_FLOW_SPECS_JSON=
# Leave REGISTER_FLOW_SPECS_JSON blank to use the compose default mixed rules.
# REGISTER_FLOW_SPECS_JSON=[{"name":"openai-main","path":"server/services/orchestration_service/flows/codex-openai-account-v1.semantic-flow.json","role":"main","weight":5},{"name":"openai-continue","path":"server/services/orchestration_service/flows/codex-openai-oauth-continue-v1.semantic-flow.json","role":"continue","weight":2},{"name":"openai-account-availability-audit","path":"server/services/orchestration_service/flows/openai-account-availability-audit-v1.semantic-flow.json","role":"account-audit","weight":1,"inputSourceDir":"/shared/register-output","concurrencyLimit":1},{"name":"codex-team-expand","path":"server/services/orchestration_service/flows/codex-team-expand-v1.semantic-flow.json","role":"team","weight":1}]
REGISTER_TEAM_AUTH_PATH=
REGISTER_TEAM_AUTH_PATHS=
REGISTER_TEAM_AUTH_GLOB=*-team.json
REGISTER_TEAM_AUTH_LOCAL_DIR=
REGISTER_TEAM_AUTH_DEFAULT_DIR=
REGISTER_TEAM_AUTH_DIR=

REGISTER_DASHBOARD_ENABLED=false
REGISTER_LOOP_DELAY_SECONDS=30
REGISTER_WORKER_COUNT=10
REGISTER_MAIN_CONCURRENCY_LIMIT=5
REGISTER_CONTINUE_CONCURRENCY_LIMIT=2
REGISTER_TEAM_CONCURRENCY_LIMIT=1
REGISTER_WORKER_STAGGER_SECONDS=1
REGISTER_INFINITE_MAX_RUNS=0
REGISTER_TASK_MAX_ATTEMPTS=0
REGISTER_ACCOUNT_AUDIT_STALE_CLAIM_SECONDS=21600
# Rotate the audit log once it reaches this size. It is the only record of what
# the audit deleted, so rotation keeps one generation instead of truncating.
# Set to 0 to disable rotation and let it grow.
REGISTER_ACCOUNT_AUDIT_LOG_MAX_BYTES=33554432
REGISTER_ACCOUNT_AUDIT_WORKER_HARD_TIMEOUT_SECONDS=420
# Accounts claimed per production audit run. The batch shares one proxy lease
# and one protocol call bounded by EASY_PROTOCOL_ACCOUNT_AUDIT_TIMEOUT_SECONDS;
# accounts the protocol cannot reach in that budget are reported as
# account_audit_timeout_exceeded and stay due for the next run rather than
# serving a 12h cooldown, so oversizing this only rolls the tail over.
REGISTER_ACCOUNT_AUDIT_MAX_TARGETS=4

REGISTER_OPENAI_OAUTH_POOL_DIR=
REGISTER_OPENAI_OAUTH_SUCCESS_POOL_DIR=
REGISTER_OPENAI_OAUTH_WAIT_POOL_DIR=
REGISTER_OPENAI_OAUTH_CONTINUE_POOL_DIR=
REGISTER_OPENAI_OAUTH_WAIT_SECONDS=
REGISTER_OPENAI_OAUTH_CONTINUE_PREFILL_COUNT=
REGISTER_OPENAI_OAUTH_CONTINUE_PREFILL_TARGET_COUNT=
REGISTER_OPENAI_OAUTH_CONTINUE_PREFILL_MIN_AGE_SECONDS=
REGISTER_OPENAI_OAUTH_SEED_MAX_AGE_SECONDS=900
REGISTER_OPENAI_UPLOAD_PERCENT=0
REGISTER_CODEX_FREE_UPLOAD_PERCENT=0
REGISTER_CODEX_TEAM_UPLOAD_PERCENT=0
REGISTER_CODEX_PLUS_UPLOAD_PERCENT=0

REGISTER_MAILBOX_ROUTING_PROFILE_ID=
REGISTER_MAILBOX_STRATEGY_MODE_ID=
REGISTER_MAILBOX_PROVIDERS=
REGISTER_MAILBOX_BUSINESS_KEY=generic
REGISTER_MAILBOX_DOMAIN_POOL=
REGISTER_MAILBOX_DOMAIN_BLACKLIST=coolkid.icu,shaole.me,cpu.edu.kg,tmail.bio,do4.tech
REGISTER_MAILBOX_PROVIDER_BLACKLIST=
REGISTER_MAILBOX_DOMAIN_CONSECUTIVE_FAILURE_BLACKLIST_THRESHOLD=500
REGISTER_MAILBOX_DYNAMIC_BLACKLIST_EXHAUSTED_FALLBACK=false
REGISTER_MAILBOX_BUSINESS_POLICIES_JSON={"default":{"explicitBlacklistDomains":["coolkid.icu","shaole.me","cpu.edu.kg","tmail.bio","do4.tech"],"providerBlacklist":[]},"openai":{"explicitBlacklistDomains":["coolkid.icu","shaole.me","cpu.edu.kg","tmail.bio","do4.tech"],"providerBlacklist":[]}}
REGISTER_SMS_BUSINESS_KEY=openai
REGISTER_SMS_PROVIDER_BLACKLIST=
REGISTER_SMS_ALLOW_PAID=true
REGISTER_SMS_ALLOW_REUSE=false
REGISTER_SMS_MAX_BINDINGS_PER_PHONE=1
REGISTER_SMS_COUNTRY_CODES=
REGISTER_SMS_SELECTION_MODE=balanced
REGISTER_SMS_BUSINESS_POLICIES_JSON={"default":{"enabled":false,"providerBlacklist":[],"allowPaid":true},"openai":{"enabled":true,"providerBlacklist":[],"allowPaid":true,"allowReuse":false,"maxBindingsPerPhone":1,"countryCodes":[],"selectionMode":"balanced"}}

# Compose-side host output aliases are configured outside this runtime env file.
# Use scripts/deploy-compose.ps1 plus these host env vars when you need directory links:
# REGISTER_OUTPUT_DIR_HOST
# deploy-host.ps1 can also split only credential result pools onto a NAS root:
# REGISTER_CREDENTIAL_ROOT_HOST
# REGISTER_CODEX_ROOT_DIR_HOST
# REGISTER_OPENAI_ROOT_DIR_HOST
# REGISTER_CODEX_ROOT_DOCKER_SOURCE
# REGISTER_OPENAI_ROOT_DOCKER_SOURCE
# REGISTER_CODEX_ROOT_DOCKER_VOLUME
# REGISTER_OPENAI_ROOT_DOCKER_VOLUME
# REGISTER_OUTPUT_ALIAS_ROOT_HOST
# REGISTER_OPENAI_PENDING_DIR_HOST
# REGISTER_OPENAI_CONVERTED_DIR_HOST
# REGISTER_OPENAI_FAILED_ONCE_DIR_HOST
# REGISTER_OPENAI_FAILED_TWICE_DIR_HOST
# REGISTER_CODEX_FREE_DIR_HOST
# REGISTER_CODEX_TEAM_DIR_HOST
# REGISTER_CODEX_PLUS_DIR_HOST
# REGISTER_CODEX_TEAM_INPUT_DIR_HOST
# REGISTER_CODEX_TEAM_MOTHER_INPUT_DIR_HOST
# Current local defaults live in deploy-host.ps1.
